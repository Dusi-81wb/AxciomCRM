# Flask Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Application Security
# Replace with a cryptographically secure random string in production (e.g., secrets.token_hex(32))
SECRET_KEY=change-this-to-a-secure-random-key

# Database Connection (PostgreSQL with psycopg2)
DATABASE_URL=postgresql://postgres:password@localhost:5432/acxiomcrm
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/acxiomcrm_test

# Session Cookie Security Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Business Timezone (Mandated: Asia/Kolkata)
APPLICATION_TIMEZONE=Asia/Kolkata

# Authentication & Account Security Thresholds (Used in subsequent phases)
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
